# The cwd lock an older version of this driver wrote into the directory it protected. It lives in
# ~/.codex-delegate/locks/ now, but a stale copy would otherwise be committed by a `git add -A` turn —
# which is the exact failure that moved it out.
.codex-delegate.lock

.DS_Store

# Claude Code's per-checkout state, none of it this plugin's payload: the model pin in
# settings.local.json is one machine's, and worktrees/ is where --worktree cuts its trees.
# They stay untracked here only via one contributor's global excludes otherwise.
.claude/
